extends Node2D
# Transparent liquid-only overlay. Place origin at the illustrated vessel body.
# kind 0: side vessel 180x100, kind 1: central vessel 210x90.
var potion_color = Color(0.2, 1.0, 0.5)
var fill_amount = 0.0
var target_fill = 0.0
var kind = 0
var clock_time = 0.0
var body_width = 180.0
var body_height = 100.0
var neck_y = -110.0

func configure(color: Color, vessel_kind = 0):
	potion_color = color
	kind = int(vessel_kind)
	body_width = 210.0 if kind == 1 else 180.0
	body_height = 90.0 if kind == 1 else 100.0
	neck_y = -90.0 if kind == 1 else -110.0
	update()

func set_fill(value):
	target_fill = clamp(float(value), 0.0, 1.0)

func _process(delta):
	clock_time += delta
	fill_amount = lerp(fill_amount, target_fill, min(delta * 2.6, 1.0))
	if abs(fill_amount - target_fill) < 0.0002:
		fill_amount = target_fill
	update()

func width_at(y):
	var normalized = y / (body_height * 0.5)
	return body_width * 0.5 * sqrt(max(0.0, 1.0 - normalized * normalized))

func wave_at(x, width):
	var envelope = max(0.0, 1.0 - pow(x / max(width, 0.1), 2))
	return (sin(x * 0.075 + clock_time * 2.1) * 1.3 + sin(x * 0.035 - clock_time * 1.7) * 0.7) * envelope

func tint(alpha, light = 0.0):
	var color = potion_color.lightened(light) if light >= 0 else potion_color.darkened(-light)
	color.a = alpha
	return color

func _draw():
	_draw_vapor()
	if fill_amount < 0.002:
		return
	var bottom = body_height * 0.5
	# Keep a small head space, preserving the original illustrated neck.
	var surface = lerp(bottom - 0.5, -body_height * 0.43, fill_amount)
	var width = width_at(surface)
	var points = PoolVector2Array()
	var colors = PoolColorArray()
	for i in range(49):
		var x = lerp(-width, width, float(i) / 48.0)
		var y = min(bottom, surface + wave_at(x, width) * min(fill_amount * 12, 1.0))
		points.append(Vector2(x, y))
		colors.append(tint(0.91, 0.18))
	for i in range(1, 49):
		var y = lerp(surface, bottom, float(i) / 48.0)
		points.append(Vector2(width_at(y), y))
		colors.append(tint(0.88, -0.26 * float(i) / 48.0))
	for i in range(47, 0, -1):
		var y = lerp(surface, bottom, float(i) / 48.0)
		points.append(Vector2(-width_at(y), y))
		colors.append(tint(0.88, -0.26 * float(i) / 48.0))
	draw_polygon(points, colors)
	# Thin illuminated meniscus follows the moving surface.
	var edge = PoolVector2Array()
	for i in range(49):
		var x = lerp(-width, width, float(i) / 48.0)
		edge.append(Vector2(x, min(bottom, surface + wave_at(x, width) * min(fill_amount * 12, 1.0))))
	draw_polyline(edge, tint(0.12, 0.65), 7.0, true)
	draw_polyline(edge, tint(0.65, 0.63), 1.4, true)
	# Rising bubbles are individually checked against the curved liquid boundary.
	for i in range(24):
		var seed_value = float(i) * 0.6180339
		var phase = fmod(seed_value + clock_time * (0.13 + float(i % 5) * 0.017), 1.0)
		var bubble_radius = 1.3 + float(i % 4) * 0.68
		var bubble_y = lerp(bottom - 5, surface + 5, phase)
		var lane = sin(float(i) * 17.19) * body_width * 0.41
		var bubble_x = lane + sin(clock_time * 1.8 + i) * 2.4
		if bubble_y - bubble_radius < surface + 3 or bubble_y + bubble_radius > bottom:
			continue
		if abs(bubble_x) + bubble_radius + 2 > min(width_at(bubble_y - bubble_radius), width_at(bubble_y + bubble_radius)):
			continue
		var center = Vector2(bubble_x, bubble_y)
		draw_circle(center, bubble_radius, tint(0.24, 0.7))
		draw_arc(center, bubble_radius, PI * 1.02, PI * 1.7, 8, tint(0.66, 0.83), 0.8, true)
	# Small interior glints; no outline or opaque background is drawn.
	for i in range(8):
		var px = sin(i * 21.7) * body_width * 0.37
		var py = surface + 8 + fmod(float(i) * 13.3, max(1.0, bottom - surface - 13))
		if py + 3 < bottom and abs(px) + 3 < width_at(py) and py > surface + 5:
			var alpha = (0.16 + 0.17 * sin(clock_time * 2.7 + i)) * fill_amount
			draw_circle(Vector2(px, py), 1.1, tint(max(0, alpha), 0.9))

func _draw_vapor():
	# Vapor persists even with an empty vessel; color is never bleached to white.
	# The central plume is shorter to leave the Potion Master lettering readable.
	var rise = 52.0 if kind == 1 else 91.0
	var drift = 10.0 if kind == 1 else 19.0
	var offset = float(kind) * 1.7 + potion_color.b * 2.4
	for i in range(15):
		var phase = fmod(clock_time * 0.16 + float(i) / 15.0, 1.0)
		var sway = sin(phase * 7.0 - clock_time * 0.7 + offset)
		var center = Vector2(sway * (3.0 + phase * drift), neck_y - 3.0 - phase * rise)
		center.x += sin(float(i) * 2.4 + clock_time * 0.35) * phase * 4.0
		var puff_size = 4.0 + phase * 13.0
		var envelope = sin(phase * PI) * pow(1.0 - phase, 0.45)
		var opacity = envelope * (0.027 + fill_amount * 0.012)
		# Overlapping feathered discs form a continuous translucent curling plume.
		for layer in range(7, 0, -1):
			var fraction = float(layer) / 7.0
			var shape_offset = Vector2(sin(phase * 10 + fraction * 2) * 2.5, 0)
			draw_circle(center + shape_offset, puff_size * fraction, tint(opacity, 0.12))
	# Sparse saturated motes rise out of the same neck, independently of fill.
	for i in range(7):
		var phase = fmod(clock_time * 0.22 + float(i) * 0.143, 1.0)
		var p = Vector2(sin(phase * 8 + i + offset) * (4 + phase * drift), neck_y - phase * rise)
		var alpha = sin(phase * PI) * 0.42
		draw_circle(p, 1.05 + float(i % 2) * 0.45, tint(alpha, 0.30))
